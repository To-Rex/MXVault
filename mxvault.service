[Unit]
Description=MXVault - PostgreSQL Backup Management Platform
After=network.target

[Service]
Type=simple
User=mxvault
Group=mxvault
WorkingDirectory=/opt/mxvault
EnvironmentFile=/opt/mxvault/.env
ExecStart=/opt/mxvault/venv/bin/python run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
